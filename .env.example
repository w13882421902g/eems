# ===== 大模型接口配置示例 =====
# 复制本文件为 .env（.env 已被 .gitignore 忽略），把 AI_API_KEY 换成自己的 Key。

AI_API_KEY=sk-你的Key
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_MODEL=Qwen/Qwen2.5-7B-Instruct
AI_TIMEOUT=20

# 其它服务商：
# DeepSeek        AI_BASE_URL=https://api.deepseek.com/v1            AI_MODEL=deepseek-chat
# 阿里百炼        AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_MODEL=qwen-plus
# 火山方舟(豆包)   AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3  AI_MODEL=ep-你的接入点ID
# OpenAI          AI_BASE_URL=https://api.openai.com/v1              AI_MODEL=gpt-4o-mini
